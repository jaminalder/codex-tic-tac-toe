{{ define "content" }}
<h1 class="title">Game</h1>
<p class="subtitle">Click a cell to place your chosen icon</p>

<div class="box" x-data="{ 
    cells: Array(9).fill(''), 
    icon: (new URLSearchParams(window.location.search).get('icon') || '❌'),
    mark(i){ if(this.cells[i] !== '') return; this.cells[i] = this.icon }, 
    reset(){ this.cells = Array(9).fill('') }
  }">
  <p class="mb-3">Your icon: <span x-text="icon"></span></p>
  <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; max-width: 360px;">
    <button type="button" class="button is-large is-fullwidth" x-text="cells[0]" @click="mark(0)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[1]" @click="mark(1)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[2]" @click="mark(2)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[3]" @click="mark(3)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[4]" @click="mark(4)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[5]" @click="mark(5)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[6]" @click="mark(6)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[7]" @click="mark(7)"></button>
    <button type="button" class="button is-large is-fullwidth" x-text="cells[8]" @click="mark(8)"></button>
  </div>
  <div class="mt-4">
    <button type="button" class="button" @click="reset()">Reset</button>
    <a href="/" class="button is-light ml-2">Back to Home</a>
  </div>
  <p class="is-size-7 has-text-grey mt-3">No server logic yet — purely client-side using Alpine.js.</p>
  </div>
{{ end }}

{{ template "base.html.tmpl" . }}
