{{ define "content" }}
<h1 class="title">Tic-Tac-Toe</h1>
<p class="subtitle">Pick a fun icon, then start a new game</p>

<div class="box" x-data="{ icons: ['😺','🤖','🐶','👾','🦄','🐸','🐼','🐙'], selected: '' }">
  <p class="mb-3">Choose your icon:</p>
  <div class="buttons">
    <template x-for="(ic, idx) in icons" :key="idx">
      <button type="button"
              class="button is-light"
              :class="{ 'is-info': selected === ic }"
              @click="selected = ic"
              x-text="ic"
              title="Pick icon"></button>
    </template>
  </div>

  <form class="mt-3" method="post" action="/game">
    <input type="hidden" name="icon" :value="selected">
    <button class="button is-primary" :disabled="!selected">New Game</button>
  </form>

  <p class="is-size-7 has-text-grey mt-4">Bulma, HTMX, and Alpine are loaded via CDN.</p>
  <p class="is-size-7 has-text-grey">This page is served by the stdlib `net/http` server.</p>
  </div>
{{ end }}

{{ template "base.html.tmpl" . }}
